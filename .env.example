# nit-ba-etl — configuração local de exemplo
# Copie para .env e ajuste os valores. O arquivo .env NUNCA deve ser
# versionado (AGENTS.md §5).

# --- Banco de dados PostgreSQL (obrigatório) ---
# DSN completo com credenciais do usuário do ETL.
# O usuário deve ter permissões LIMITADAS (architecture.md §6.2): criar
# e escrever no schema staging; a carga canônica depende dos contratos
# aprovados com o backend.
# Exemplo local:  postgresql://etl:senha@localhost:5432/nitba
ETL_DATABASE_DSN=

# --- Logging (opcional) ---
# Níveis: DEBUG | INFO | WARNING | ERROR | CRITICAL  (default: INFO)
ETL_LOG_LEVEL=INFO

# --- Diretório de dados (opcional) ---
# Default: <diretório de trabalho>/data (raiz do repo em dev;
# /app/data no container, onde o volume é montado pelo nit-ba-infra).
# ETL_DATA_DIR=/caminho/para/data
